<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.name }}{% endblock %}</title>
<style>
{{ theme_css }}
{% include "_styles.css.j2" %}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="draft" role="note">Draft: facts not verified. Founder must review before use. This site has not been published.</div>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="{{ home_href }}">{{ logo }}<span>{{ site.name }}</span></a>
    <nav class="site-nav" aria-label="Site">
      <a class="optional" href="{{ home_href }}">Home</a>
      <a href="{{ start_href }}">What is inside</a>
    </nav>
  </div>
</header>
<main id="main" tabindex="-1">
<div class="wrap">
{% block main %}{% endblock %}
</div>
</main>
<footer class="site-footer">
  <div class="wrap bar">
    <p><strong>{{ site.name }}</strong>. Draft produced for the founder's review. Terms, privacy and refund policies are added at the price and policies step.</p>
    <p>Checkout is <span class="mocked">MOCKED</span>. No payment is taken.</p>
  </div>
</footer>
</body>
</html>
