# Copy to .env and set your OpenRouter key (https://openrouter.ai/keys). The model runs on OpenRouter.
# Backend: "openai" (OpenRouter or any OpenAI-compatible endpoint) or "ollama" (local, native API with JSON schema)
LLM_BACKEND=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
# Replace the placeholder with your OpenRouter key (https://openrouter.ai/keys)
LLM_API_KEY=placeholder
# Same weights as the local gpt-oss:20b. Qwen3 4B is not on OpenRouter; qwen/qwen3-30b-a3b-instruct-2507 is the nearest Qwen3 instruct.
LLM_MODEL=openai/gpt-oss-20b
LLM_MODE=live
FAST_MODE=false
# New pages one agent step may fetch (3 in FAST_MODE)
MAX_SOURCES=6
SEARXNG_URL=http://searxng:8080
# General web search through the keyless ddgs library; set to false to use only the SearXNG container.
DDGS_ENABLED=true
SEARXNG_SECRET=placeholder
# The project's repository URL, sent in the User-Agent of every outgoing request. Never an email address.
CONTACT_URL=https://github.com/your-org/your-repo
# Phase 1 planners (and roadmap proposals); FAST_MODE=true always uses 1
N_ARCHITECTS=1
# Run budget: a run that exceeds either ends as STOPPED
MAX_MODEL_CALLS=60
MAX_RUN_SECONDS=900
LLM_NUM_CTX=8192
# Ollama-only thinking: auto (off, or low for gpt-oss models, which cannot switch it off), false, true, low, medium, high
LLM_THINK=auto
# USD per million tokens (gpt-oss-20b on OpenRouter: 0.018 in, 0.09 out)
LLM_PRICE_IN_PER_MTOK=0.018
LLM_PRICE_OUT_PER_MTOK=0.09
LLM_TIMEOUT_SECONDS=300
APP_PORT=8000
