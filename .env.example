# Copy to .env only if you want to change a default. docker compose up works without it.
# Backend: "ollama" (local, native API with JSON schema) or "openai" (any OpenAI-compatible hosted endpoint)
LLM_BACKEND=ollama
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=placeholder
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_MODE=live
FAST_MODE=false
# New pages one agent step may fetch (3 in FAST_MODE)
MAX_SOURCES=6
SEARXNG_URL=http://searxng:8080
# General web search through the keyless ddgs library; set to false to use only the SearXNG container.
DDGS_ENABLED=true
# true: the Build step also assembles a small static site for a text product from fixed templates.
SITE_TEMPLATES=false
# Build step: after code checks a draft, the model revises it this many times at most (0 = off, hard cap 3).
# Remove the line to get the default: 1, or 0 when FAST_MODE=true.
REVIEW_STEPS=1
SEARXNG_SECRET=placeholder
# The project's repository URL, sent in the User-Agent of every outgoing request. Never an email address.
CONTACT_URL=https://github.com/your-org/your-repo
# Phase 1 planners (and roadmap proposals); FAST_MODE=true always uses 1
N_ARCHITECTS=1
# Run budget: a run that exceeds either ends as STOPPED
MAX_MODEL_CALLS=60
MAX_RUN_SECONDS=900
LLM_NUM_CTX=8192
# Ollama thinking: auto (off, or low for gpt-oss models, which cannot switch it off), false, true, low, medium, high
LLM_THINK=auto
# USD per million tokens; 0 for a local model
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
LLM_TIMEOUT_SECONDS=300
APP_PORT=8000
