# Copy to .env only if you want to change a default. docker compose up works without it.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=placeholder
LLM_MODEL=qwen3:8b
LLM_MODE=live
FAST_MODE=false
MAX_SOURCES=6
# USD per million tokens; 0 for a local model
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
LLM_TIMEOUT_SECONDS=300
APP_PORT=8000
